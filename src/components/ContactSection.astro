---
import { companyData } from '../data/company';
---

<section class="contact-section" id="contact">
  <div class="container">
    <div class="section-header">
      <span class="section-en-title">Contact & Company</span>
      <h2 class="section-title">会社情報・お問い合わせ</h2>
      <p class="section-lead">
        水まわりの緊急トラブルのご相談からリフォームのお見積もりまで、<br class="br-pc" />
        お電話またはWebフォームにてお気軽にお問い合わせください。
      </p>
    </div>

    <div class="contact-grid">
      <!-- 電話相談カード -->
      <div class="contact-action-card emergency-box">
        <span class="card-badge">24時間365日受付</span>
        <h3 class="card-title">お急ぎの方・緊急トラブル</h3>
        <p class="card-desc">
          「水が吹き出している」「トイレの水が止まらない」など至急の修理は、緊急直通ダイヤルへ今すぐお電話ください。
        </p>

        <a href={`tel:${companyData.telEmergency}`} class="emergency-big-btn">
          <span class="em-icon">📞</span>
          <div class="em-text">
            <span class="em-label">緊急直通（担当：津久井）</span>
            <span class="em-num">{companyData.telEmergency}</span>
          </div>
        </a>

        <div class="regular-call-box">
          <span class="reg-label">通常のお問い合わせ・ご予約（08:00〜17:00 / 日曜休）：</span>
          <a href={`tel:${companyData.telMain}`} class="reg-num">TEL: {companyData.telMain}</a>
        </div>
      </div>

      <!-- Webフォーム -->
      <div class="contact-action-card form-box">
        <span class="card-badge badge-blue">無料お見積り・写真添付対応</span>
        <h3 class="card-title">Webお問い合わせフォーム</h3>
        <p class="card-desc">
          リフォームのご相談、現場写真付きでの事前見積もり依頼はこちらからお送りください。
        </p>

        <form class="contact-form" name="contact" method="POST" enctype="multipart/form-data" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden-field" style="display:none;">
            <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="form-group">
            <label for="name">お名前 <span class="required">必須</span></label>
            <input type="text" id="name" name="name" required placeholder="例：那須 太郎" class="form-control" />
          </div>

          <div class="form-group">
            <label for="tel">お電話番号 <span class="required">必須</span></label>
            <input type="tel" id="tel" name="tel" required placeholder="例：090-1234-5678" class="form-control" />
          </div>

          <div class="form-group">
            <label for="email">メールアドレス <span class="optional">任意</span></label>
            <input type="email" id="email" name="email" placeholder="例：example@sweet.ocn.ne.jp" class="form-control" />
          </div>

          <div class="form-group">
            <label for="city">お住まいの地域 <span class="required">必須</span></label>
            <select id="city" name="city" required class="form-control">
              <option value="">選択してください</option>
              <option value="那須塩原市">那須塩原市</option>
              <option value="大田原市">大田原市</option>
              <option value="那須町">那須町</option>
              <option value="その他地域">その他近隣地域</option>
            </select>
          </div>

          <div class="form-group photo-upload-group">
            <label for="photo">
              現場の写真添付 <span class="optional">任意（スマホ撮影写真OK・複数可）</span>
            </label>
            <div class="photo-upload-zone" id="photoDropZone">
              <input 
                type="file" 
                id="photo" 
                name="photo" 
                accept="image/*" 
                multiple 
                class="photo-hidden-input" 
              />
              <div class="photo-prompt" id="photoPrompt">
                <span class="photo-camera-icon">📷</span>
                <span class="photo-prompt-main">ここをタップして写真を選択 または 撮影</span>
                <span class="photo-prompt-sub">水漏れ箇所や蛇口・給湯器の型番など（複数選択可能）</span>
              </div>
              <div class="photo-preview-grid" id="photoPreviewGrid"></div>
            </div>
            <span class="input-help">※写真がなくてもそのままご相談・お見積もり可能です。</span>
          </div>

          <div class="form-group">
            <label for="message">ご相談内容 <span class="required">必須</span></label>
            <textarea id="message" name="message" rows="4" required placeholder="症状やご希望をご記入ください（例：キッチンの蛇口の根元から水がにじみ出ています）" class="form-control"></textarea>
          </div>

          <button type="submit" class="btn btn-phone btn-full-submit">
            上記の内容で問い合わせる
          </button>
        </form>
      </div>
    </div>

    <!-- 会社概要詳細テーブル -->
    <div class="company-detail-card" id="company">
      <h3 class="detail-title">有限会社クリプトン 会社概要</h3>
      <table class="detail-table">
        <tbody>
          <tr>
            <th>会社名</th>
            <td>{companyData.name}</td>
          </tr>
          <tr>
            <th>屋号</th>
            <td>{companyData.tradeName}</td>
          </tr>
          <tr>
            <th>代表者</th>
            <td>{companyData.representative}</td>
          </tr>
          <tr>
            <th>所在地</th>
            <td>
              〒{companyData.postalCode} {companyData.address}<br />
              <span class="address-note">（栃木県北部の黒磯駅周辺・那須街道アクセス良好）</span>
            </td>
          </tr>
          <tr>
            <th>連絡先</th>
            <td>
              代表TEL: {companyData.telMain} / FAX: {companyData.fax}<br />
              緊急直通: {companyData.telEmergency}（24時間365日受付）
            </td>
          </tr>
          <tr>
            <th>公式メールアドレス</th>
            <td>
              <a href={`mailto:${companyData.email}`} class="mail-link">{companyData.email}</a>
            </td>
          </tr>
          <tr>
            <th>公認指定工事店</th>
            <td>
              <strong>【給水装置工事指定事業者】</strong><br />
              {companyData.waterSupplyLicenses.join('、')}<br /><br />
              <strong>【指定排水設備工事店】</strong><br />
              {companyData.drainageLicenses.join('、')}
            </td>
          </tr>
          <tr>
            <th>保有国家資格</th>
            <td>{companyData.qualifications.join(' / ')}</td>
          </tr>
          <tr>
            <th>社名の由来</th>
            <td>
              アメリカコミックのスーパーヒーロー（スーパーマンの故郷「クリプトン星」）に由来し、水まわりのピンチに迅速に駆けつける正義と信頼の専門施工会社を目指して名付けられました。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 70px 0;
    background: var(--color-bg-sub);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    margin-bottom: 50px;
  }

  .contact-action-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 30px 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .emergency-box {
    border-top: 5px solid var(--color-phone);
  }

  .form-box {
    border-top: 5px solid var(--color-sub);
  }

  .card-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    background: #FFF1F0;
    color: #CF1322;
    margin-bottom: 12px;
  }

  .badge-blue {
    background: #E6F7FF;
    color: #096DD9;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 24px;
  }

  .emergency-big-btn {
    background: linear-gradient(135deg, #FF9E2C, #F39833);
    color: #FFFFFF !important;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    box-shadow: var(--shadow-phone);
    margin-bottom: 20px;
    transition: transform 0.2s;
  }

  .emergency-big-btn:hover {
    transform: translateY(-2px);
  }

  .em-icon {
    font-size: 2rem;
  }

  .em-text {
    display: flex;
    flex-direction: column;
  }

  .em-label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .em-num {
    font-family: var(--font-en);
    font-size: 1.55rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .regular-call-box {
    background: var(--color-bg-sub);
    padding: 14px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
  }

  .reg-label {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .reg-num {
    font-family: var(--font-en);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-main);
  }

  .photo-upload-zone {
    position: relative;
    border: 2px dashed #1976BB;
    background: #F4F9FD;
    border-radius: var(--radius-sm);
    padding: 22px 16px;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .photo-upload-zone:hover {
    background: #E8F4FD;
    border-color: #123B65;
  }
  .photo-hidden-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 5;
  }
  .photo-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }
  .photo-camera-icon {
    font-size: 2.2rem;
  }
  .photo-prompt-main {
    font-weight: 800;
    font-size: 0.95rem;
    color: #1976BB;
  }
  .photo-prompt-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .photo-preview-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 10;
  }
  .photo-preview-card {
    width: 90px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .photo-preview-card img {
    width: 100%;
    height: 70px;
    object-fit: cover;
    border-radius: 4px;
  }
  .photo-preview-name {
    font-size: 0.68rem;
    color: var(--color-text);
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80px;
  }
  .photo-reselect-btn {
    background: #FFFFFF;
    border: 1px solid #1976BB;
    color: #1976BB;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .photo-reselect-btn:hover {
    background: #1976BB;
    color: #FFFFFF;
  }

  .optional {
    font-size: 0.7rem;
    background: #E2E8F0;
    color: #475569;
    padding: 2px 6px;
    border-radius: 3px;
    margin-left: 6px;
  }
  .file-input {
    padding: 8px;
    background: #FFFFFF;
    border: 1px dashed var(--color-border);
  }
  .input-help {
    font-size: 0.76rem;
    color: #64748B;
    margin-top: 4px;
  }

  /* フォーム */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-main);
  }

  .required {
    background: #CF1322;
    color: #FFFFFF;
    font-size: 0.65rem;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
  }

  .form-control {
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    background: #FAFAFA;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-sub);
    background: #FFFFFF;
  }

  .btn-full-submit {
    width: 100%;
    padding: 14px;
    margin-top: 8px;
  }

  /* 会社概要テーブル */
  .company-detail-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 35px 30px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .detail-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 20px;
    border-left: 4px solid var(--color-sub);
    padding-left: 12px;
  }

  .detail-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .detail-table th {
    width: 28%;
    background: var(--color-bg-sub);
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    color: var(--color-main);
    font-weight: 700;
    vertical-align: top;
    text-align: left;
  }

  .detail-table td {
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.65;
  }

  .address-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .detail-table th, .detail-table td {
      display: block;
      width: 100%;
    }
    .detail-table th {
      border-bottom: none;
    }
</style>

<script>
  function setupPhotoUpload() {
    const photoInput = document.getElementById('photo') as HTMLInputElement | null;
    const photoPrompt = document.getElementById('photoPrompt');
    const previewGrid = document.getElementById('photoPreviewGrid');

    if (photoInput && previewGrid && photoPrompt) {
      photoInput.addEventListener('change', () => {
        previewGrid.innerHTML = '';
        const files = photoInput.files;
        if (files && files.length > 0) {
          photoPrompt.style.display = 'none';
          Array.from(files).forEach((file, index) => {
            if (!file.type.startsWith('image/')) return;
            const reader = new FileReader();
            reader.onload = (e) => {
              const card = document.createElement('div');
              card.className = 'photo-preview-card';
              card.innerHTML = `
                <img src="${e.target?.result}" alt="添付写真 ${index + 1}" />
                <span class="photo-preview-name">${file.name}</span>
              `;
              previewGrid.appendChild(card);
            };
            reader.readAsDataURL(file);
          });

          // 再選択ボタン
          const reselectBtn = document.createElement('button');
          reselectBtn.type = 'button';
          reselectBtn.className = 'photo-reselect-btn';
          reselectBtn.innerHTML = '🔄 写真を選び直す';
          reselectBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            photoInput.value = '';
            previewGrid.innerHTML = '';
            photoPrompt.style.display = 'flex';
          });
          previewGrid.appendChild(reselectBtn);
        } else {
          photoPrompt.style.display = 'flex';
        }
      });
    }
  }

  // 初回実行およびView Transitions対応
  setupPhotoUpload();
  document.addEventListener('astro:page-load', setupPhotoUpload);
</script>
