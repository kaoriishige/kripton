---
import { companyData } from '../data/company';
---

<section class="contact-section" id="contact">
  <div class="container">
    <div class="section-header">
      <span class="section-en-title">Contact & Company</span>
      <h2 class="section-title">会社情報・お問い合わせ</h2>
      <p class="section-lead">
        水まわりの緊急トラブルのご相談からリフォームのお見積もりまで、<br class="br-pc" />
        お電話またはWebフォームにてお気軽にお問い合わせください。
      </p>
    </div>

    <div class="contact-grid">
      <!-- 電話相談カード -->
      <div class="contact-action-card emergency-box">
        <span class="card-badge">24時間365日受付</span>
        <h3 class="card-title">お急ぎの方・緊急トラブル</h3>
        <p class="card-desc">
          「水が吹き出している」「トイレの水が止まらない」など至急の修理は、緊急直通ダイヤルへ今すぐお電話ください。
        </p>

        <a href={`tel:${companyData.telEmergency}`} class="emergency-big-btn">
          <span class="em-icon">📞</span>
          <div class="em-text">
            <span class="em-label">緊急直通（担当：津久井）</span>
            <span class="em-num">{companyData.telEmergency}</span>
          </div>
        </a>

        <div class="regular-call-box">
          <span class="reg-label">通常のお問い合わせ・ご予約（8:00〜19:00）：</span>
          <a href={`tel:${companyData.telMain}`} class="reg-num">TEL: {companyData.telMain}</a>
        </div>

        <!-- LINE相談ボックス -->
        <div class="line-call-box" id="line">
          <div class="line-badge">写真で簡単見積り</div>
          <h4 class="line-title">💬 LINEで写真を送って無料相談</h4>
          <p class="line-desc">
            水漏れ箇所や給湯器・蛇口の型番プレートの写真をLINEで送信するだけで、概算費用や修理可能かをスピーディーにご案内します。
          </p>
          <a href="https://line.me" target="_blank" rel="noopener noreferrer" class="line-big-btn">
            LINE友だち追加で相談する
          </a>
        </div>
      </div>

      <!-- Webフォーム -->
      <div class="contact-action-card form-box">
        <span class="card-badge badge-blue">無料お見積り・ご相談</span>
        <h3 class="card-title">Webお問い合わせフォーム</h3>
        <p class="card-desc">
          リフォームのご相談、定期点検、写真付きでの事前相談などはこちらからお送りください。
        </p>

        <form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden-field" style="display:none;">
            <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="form-group">
            <label for="name">お名前 <span class="required">必須</span></label>
            <input type="text" id="name" name="name" required placeholder="例：那須 太郎" class="form-control" />
          </div>

          <div class="form-group">
            <label for="tel">お電話番号 <span class="required">必須</span></label>
            <input type="tel" id="tel" name="tel" required placeholder="例：090-1234-5678" class="form-control" />
          </div>

          <div class="form-group">
            <label for="city">お住まいの地域 <span class="required">必須</span></label>
            <select id="city" name="city" required class="form-control">
              <option value="">選択してください</option>
              <option value="那須塩原市">那須塩原市</option>
              <option value="大田原市">大田原市</option>
              <option value="那須町">那須町</option>
              <option value="その他地域">その他近隣地域</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">ご相談内容 <span class="required">必須</span></label>
            <textarea id="message" name="message" rows="4" required placeholder="症状やご希望をご記入ください（例：キッチンの蛇口の根元から水がにじみ出ています）" class="form-control"></textarea>
          </div>

          <button type="submit" class="btn btn-phone btn-full-submit">
            上記の内容で問い合わせる
          </button>
        </form>
      </div>
    </div>

    <!-- 会社概要詳細テーブル -->
    <div class="company-detail-card" id="company">
      <h3 class="detail-title">有限会社クリプトン 会社概要</h3>
      <table class="detail-table">
        <tbody>
          <tr>
            <th>会社名</th>
            <td>{companyData.name}</td>
          </tr>
          <tr>
            <th>屋号</th>
            <td>{companyData.tradeName}</td>
          </tr>
          <tr>
            <th>代表者</th>
            <td>{companyData.representative}</td>
          </tr>
          <tr>
            <th>所在地</th>
            <td>
              〒{companyData.postalCode} {companyData.address}<br />
              <span class="address-note">（栃木県北部の黒磯駅周辺・那須街道アクセス良好）</span>
            </td>
          </tr>
          <tr>
            <th>連絡先</th>
            <td>
              代表TEL: {companyData.telMain} / FAX: {companyData.fax}<br />
              緊急直通: {companyData.telEmergency}（24時間365日受付）
            </td>
          </tr>
          <tr>
            <th>公認指定工事店</th>
            <td>
              <strong>【給水装置工事指定事業者】</strong><br />
              {companyData.waterSupplyLicenses.join('、')}<br /><br />
              <strong>【指定排水設備工事店】</strong><br />
              {companyData.drainageLicenses.join('、')}
            </td>
          </tr>
          <tr>
            <th>保有国家資格</th>
            <td>{companyData.qualifications.join(' / ')}</td>
          </tr>
          <tr>
            <th>社名の由来</th>
            <td>
              アメリカコミックのスーパーヒーロー（スーパーマンの故郷「クリプトン星」）に由来し、水まわりのピンチに迅速に駆けつける正義と信頼の専門施工会社を目指して名付けられました。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 70px 0;
    background: var(--color-bg-sub);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  .contact-action-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 30px 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .emergency-box {
    border-top: 5px solid var(--color-phone);
  }

  .form-box {
    border-top: 5px solid var(--color-sub);
  }

  .card-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    background: #FFF1F0;
    color: #CF1322;
    margin-bottom: 12px;
  }

  .badge-blue {
    background: #E6F7FF;
    color: #096DD9;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 24px;
  }

  .emergency-big-btn {
    background: linear-gradient(135deg, #FF9E2C, #F39833);
    color: #FFFFFF !important;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    box-shadow: var(--shadow-phone);
    margin-bottom: 20px;
    transition: transform 0.2s;
  }

  .emergency-big-btn:hover {
    transform: translateY(-2px);
  }

  .em-icon {
    font-size: 2rem;
  }

  .em-text {
    display: flex;
    flex-direction: column;
  }

  .em-label {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .em-num {
    font-family: var(--font-en);
    font-size: 1.55rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }

  .regular-call-box {
    background: var(--color-bg-sub);
    padding: 14px;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
  }

  .reg-label {
    display: block;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .reg-num {
    font-family: var(--font-en);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-main);
  }

  .line-call-box {
    margin-top: 16px;
    background: #F0FDF4;
    border: 2px solid #86EFAC;
    border-radius: var(--radius-sm);
    padding: 16px;
  }
  .line-badge {
    display: inline-block;
    background: #05A847;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 6px;
  }
  .line-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #065F46;
    margin-bottom: 6px;
  }
  .line-desc {
    font-size: 0.82rem;
    color: #047857;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .line-big-btn {
    display: block;
    text-align: center;
    background: #06C755;
    color: #FFFFFF !important;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 12px;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(6, 199, 85, 0.3);
    transition: background 0.2s, transform 0.2s;
  }
  .line-big-btn:hover {
    background: #05A847;
    transform: translateY(-2px);
  }

  /* フォーム */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-main);
  }

  .required {
    background: #CF1322;
    color: #FFFFFF;
    font-size: 0.65rem;
    padding: 1px 5px;
    border-radius: 3px;
    margin-left: 4px;
  }

  .form-control {
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.95rem;
    background: #FAFAFA;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--color-sub);
    background: #FFFFFF;
  }

  .btn-full-submit {
    width: 100%;
    padding: 14px;
    margin-top: 8px;
  }

  /* 会社概要テーブル */
  .company-detail-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 35px 30px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .detail-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 20px;
    border-left: 4px solid var(--color-sub);
    padding-left: 12px;
  }

  .detail-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .detail-table th {
    width: 28%;
    background: var(--color-bg-sub);
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    color: var(--color-main);
    font-weight: 700;
    vertical-align: top;
    text-align: left;
  }

  .detail-table td {
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    line-height: 1.65;
  }

  .address-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .detail-table th, .detail-table td {
      display: block;
      width: 100%;
    }
    .detail-table th {
      border-bottom: none;
    }
  }
</style>
