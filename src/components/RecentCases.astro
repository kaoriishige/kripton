---
import { allCasesData } from '../data/all_cases';

// トップページでは最新4件を厳選表示（全件は一覧ページへ誘導しモバイル長尺を抑制）
const recentCases = allCasesData.slice(0, 4);
---

<section class="cases-section" id="cases">
  <div class="container">
    <div class="section-header">
      <span class="section-en-title">Recent Works</span>
      <h2 class="section-title">実際の施工事例・実績写真</h2>
      <p class="section-lead">
        那須塩原市・大田原市・那須町での実際の修繕・リフォーム現場をご紹介します。<br class="br-pc" />
        すべて自社責任施工による本物の写真と修理の工程・料金目安を公開しています。
      </p>
    </div>

    <div class="cases-grid">
      {recentCases.map(c => (
        <article class="card case-card">
          <div class="case-img-wrap">
            <img
              src={c.beforeImage}
              alt={`${c.municipality} ${c.title} 施工写真`}
              class="case-thumb-img"
              loading="lazy"
              onerror="this.src='/images/character/kripton-man4-1.jpg'"
            />
            <span class="badge badge-location-badge">{c.municipality}</span>
          </div>

          <div class="case-card-body">
            <div class="case-badge-row">
              <span class="badge">{c.category.replace('の故障・修理・リフォーム', '')}</span>
              <time class="case-date" datetime={c.date}>{c.date}</time>
            </div>

            <h3 class="case-title">
              <a href={`/works/${c.slug}/`}>{c.title}</a>
            </h3>

            <p class="case-consultation-text">{c.summary}</p>

            <div class="case-footer">
              <span class="case-price-tag">費用: <strong>{c.repairCost}</strong></span>
              <a href={`/works/${c.slug}/`} class="case-detail-btn">
                詳細・Before/After →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="cases-bottom-cta">
      <a href="/works/" class="btn btn-primary">
        施工事例一覧をもっと見る（全64件）
      </a>
    </div>
  </div>
</section>

<style>
  .cases-section {
    padding: 70px 0;
    background: var(--color-bg-sub);
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin-bottom: 35px;
  }

  .case-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #FFFFFF;
  }

  .case-img-wrap {
    height: 190px;
    position: relative;
    background: #EBF4FA;
    overflow: hidden;
  }

  .case-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .case-card:hover .case-thumb-img {
    transform: scale(1.05);
  }

  .badge-location-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
  }

  .case-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .case-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .case-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .case-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-main);
    line-height: 1.45;
    margin-bottom: 10px;
  }

  .case-title a {
    color: inherit;
  }

  .case-title a:hover {
    color: var(--color-sub);
  }

  .case-consultation-text {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 16px;
    flex: 1;
  }

  .case-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px dashed var(--color-border);
    padding-top: 12px;
  }

  .case-price-tag {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .case-price-tag strong {
    color: #CF1322;
    font-size: 0.88rem;
  }

  .case-detail-btn {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-sub);
  }

  .cases-bottom-cta {
    text-align: center;
  }

  @media (max-width: 600px) {
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
