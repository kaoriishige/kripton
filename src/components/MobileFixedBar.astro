---
import { companyData } from '../data/company';
---

<div class="mobile-fixed-cta" id="mobileFixedCta">
  <div class="cta-container">
    <a href={`tel:${companyData.telEmergency}`} class="cta-btn cta-emergency">
      <span class="cta-badge">24時間</span>
      <span class="cta-icon">🚨</span>
      <div class="cta-text-group">
        <span class="cta-sub">夜間・緊急直通</span>
        <span class="cta-main">今すぐ電話相談</span>
      </div>
    </a>
    <a href={`tel:${companyData.telMain}`} class="cta-btn cta-regular">
      <span class="cta-icon">📞</span>
      <div class="cta-text-group">
        <span class="cta-sub">通常受付 8〜19時</span>
        <span class="cta-main">{companyData.telMain}</span>
      </div>
    </a>
  </div>
</div>

<style>
  .mobile-fixed-cta {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 -3px 16px rgba(18, 59, 101, 0.15);
    border-top: 1px solid var(--color-border);
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
  }

  .cta-container {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 8px;
    max-width: 500px;
    margin: 0 auto;
  }

  .cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    min-height: 52px;
  }

  .cta-emergency {
    background: linear-gradient(135deg, #FF7A00, #E65100);
    color: #FFFFFF !important;
    box-shadow: 0 4px 10px rgba(230, 81, 0, 0.35);
  }

  .cta-regular {
    background: var(--color-main);
    color: #FFFFFF !important;
  }

  .cta-badge {
    position: absolute;
    top: 3px;
    left: 4px;
    font-size: 0.6rem;
    font-weight: 800;
    background: #FFF;
    color: #CF1322;
    padding: 1px 4px;
    border-radius: 3px;
    line-height: 1;
  }

  .cta-icon {
    font-size: 1.3rem;
  }

  .cta-text-group {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.15;
  }

  .cta-sub {
    font-size: 0.65rem;
    opacity: 0.9;
    font-weight: 500;
  }

  .cta-main {
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  @media (min-width: 900px) {
    .mobile-fixed-cta {
      display: none;
    }
  }
</style>
