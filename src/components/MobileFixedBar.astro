---
// src/components/MobileFixedBar.astro
import { companyData } from '../data/company';
---

<aside class="mobile-fixed-cta" id="mobileFixedCta" aria-label="モバイル緊急連絡バー">
  <div class="cta-container">
    <a href={`tel:${companyData.telEmergency}`} class="cta-btn cta-emergency" aria-label="夜間・緊急直通電話をかける">
      <span class="cta-badge">24時間受付</span>
      <span class="cta-icon">🚨</span>
      <div class="cta-text-group">
        <span class="cta-sub">急な水漏れ・つまり・凍結</span>
        <span class="cta-main">今すぐ電話相談（直通）</span>
      </div>
    </a>
    <a href={`tel:${companyData.telMain}`} class="cta-btn cta-regular" aria-label="代表電話をかける">
      <span class="cta-icon">📞</span>
      <div class="cta-text-group">
        <span class="cta-sub">お電話でのご相談・ご予約</span>
        <span class="cta-main">{companyData.telMain}</span>
      </div>
    </a>
  </div>
</aside>

<style>
  .mobile-fixed-cta {
    display: block !important;
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 99999 !important;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    border-top: 1px solid #E2E8F0;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px));
  }

  .cta-container {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 8px;
    max-width: 500px;
    margin: 0 auto;
  }

  .cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    position: relative;
    min-height: 52px;
    box-sizing: border-box;
  }

  .cta-emergency {
    background: linear-gradient(135deg, #FF6B00, #E65100);
    color: #FFFFFF !important;
    box-shadow: 0 4px 10px rgba(230, 81, 0, 0.35);
  }

  .cta-regular {
    background: #123B65;
    color: #FFFFFF !important;
    box-shadow: 0 2px 6px rgba(18, 59, 101, 0.2);
  }

  .cta-badge {
    position: absolute;
    top: 3px;
    left: 4px;
    font-size: 0.6rem;
    font-weight: 800;
    background: #FFFFFF;
    color: #CF1322;
    padding: 1px 4px;
    border-radius: 3px;
    line-height: 1;
  }

  .cta-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .cta-text-group {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .cta-sub {
    font-size: 0.62rem;
    opacity: 0.95;
    font-weight: 600;
    white-space: nowrap;
  }

  .cta-main {
    font-size: 0.88rem;
    font-weight: 800;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  @media (min-width: 900px) {
    .mobile-fixed-cta {
      display: none !important;
    }
  }
</style>
