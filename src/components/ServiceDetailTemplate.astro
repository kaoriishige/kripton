---
import Layout from '../layouts/Layout.astro';
import { companyData } from '../data/company';
import { allCasesData } from '../data/all_cases';
import { areasData } from '../data/areas';

export interface ServiceDetailProps {
  serviceId: string;
  title: string;
  subtitle: string;
  lead: string;
  directAnswerTitle: string;
  directAnswerSummary: string;
  directAnswerAction: string;
  cautionNotes?: string;
  troubles: { icon: string; title: string; desc: string; }[];
  steps: { step: string; title: string; desc: string; }[];
  dontDoList?: { icon: string; title: string; desc: string; }[];
  whenToCallList?: { icon: string; title: string; desc: string; }[];
  priceItems: { name: string; time: string; price: string; }[];
  faqs?: { q: string; a: string; }[];
  metaDescription: string;
}

const {
  serviceId,
  title,
  subtitle,
  lead,
  directAnswerTitle,
  directAnswerSummary,
  directAnswerAction,
  cautionNotes = "※集合住宅や受水槽方式、あるいは元栓の設置場所・型式によっては止水位置が異なる場合があります。無理な力をかけず慎重に行ってください。",
  troubles,
  steps,
  dontDoList = [
    { icon: "🚫", title: "無理に力を込めて分解・回すこと", desc: "古い配管やプラスチック部材は経年劣化で脆くなっており、過度なトルクで根元から破断・大浸水につながる危険があります。" },
    { icon: "🚫", title: "強力な塩素系薬剤の過度な投入", desc: "詰まりの原因が配管の変形や油の塊である場合、薬剤で配管が高熱を発し変形・水漏れを悪化させることがあります。" },
    { icon: "🚫", title: "熱湯を直接かけること", desc: "特に凍結時や便器の詰まりに熱湯をかけると、陶器や塩ビ配管が熱衝撃で瞬時に割れ、修理費用が跳ね上がります。" }
  ],
  whenToCallList = [
    { icon: "🚨", title: "止水栓を閉めても水が止まらないとき", desc: "建物全体の元栓または道路側の給水管に問題がある可能性が高く、指定工事店による緊急バルブ遮断が必要です。" },
    { icon: "🚨", title: "床下や壁の中からシューシュー異音がするとき", desc: "隠蔽配管の破断・漏水が進行しており、床下の腐食や構造材のダメージを防ぐため即時の漏水調査が必要です。" },
    { icon: "🚨", title: "汚水が床に逆流・噴き出しているとき", desc: "屋外本管や汚水マスの詰まりが原因で、専門のローポンプ・高圧洗浄機による抜本的な清掃が必要となります。" }
  ],
  priceItems,
  faqs = [
    { q: "見積もりに費用はかかりますか？", a: "那須塩原市・大田原市・那須町エリアの事前現地見積もりは原則無料です。修理費用は必ず現場を確認し確定見積もりをご提示してから着工します。" },
    { q: "夜間や早朝、休日でも対応してもらえますか？", a: "はい。有限会社クリプトンでは緊急直通電話（090-2463-6638）にて24時間365日受付体制をとっております。" },
    { q: "修理と新品交換のどちらが良いか迷っています。", a: "使用年数が10年未満で部品供給がある場合は修理が経済的です。15〜20年経過している場合は部品交換しても別の箇所が故障するリスクがあるため、将来的な安心を考慮して交換をおすすめする場合がございます。現場でメリット・デメリットを分かりやすく比較提示いたします。" }
  ],
  metaDescription
} = Astro.props as ServiceDetailProps;

// 関連する施工事例を抽出（最大4件）
const relatedCases = allCasesData
  .filter(c => c.relatedServiceId === serviceId)
  .slice(0, 4);

// フォールバック（0件の場合は最新事例）
const displayCases = relatedCases.length > 0 ? relatedCases : allCasesData.slice(0, 4);

const siteDomain = 'https://xn--bbkyao7065bpyck41as89d.com';
---

<Layout
  title={`${title}｜水まわり専門店クリプトン【公式】那須塩原・大田原・那須町`}
  description={metaDescription}
  breadcrumbItems={[
    { name: "水まわり修理サービス", url: "/#services" },
    { name: title }
  ]}
>
  <!-- ページヘッダー -->
  <div class="service-page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a> &gt; <a href="/#services">水まわり修理</a> &gt; <span>{title}</span>
      </nav>
      <div class="header-badges">
        <span class="badge badge-emergency">最短30分駆けつけ・24時間受付</span>
        <span class="badge">自社責任施工・指定工事店</span>
      </div>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead">{lead}</p>
    </div>
  </div>

  <div class="container page-content-container">
    <!-- AI検索・ユーザー向け ダイレクトアンサーボックス -->
    <section class="direct-answer-card">
      <div class="da-header">
        <span class="da-icon">💡</span>
        <h2 class="da-title">{directAnswerTitle}</h2>
      </div>
      <div class="da-body">
        <p><strong>最初に行うこと：</strong> {directAnswerAction}</p>
        <p><strong>解決の目安と費用：</strong> {directAnswerSummary}</p>
      </div>
    </section>

    <!-- 1. 対応する主な症状と原因 -->
    <section class="content-block">
      <h2 class="block-title">対応する主な症状と原因</h2>
      <div class="trouble-grid">
        {troubles.map(item => (
          <div class="card trouble-item">
            <h3>{item.icon} {item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. お客様ができる安全な応急処置 -->
    <section class="content-block">
      <h2 class="block-title">お客様が最初に行う安全な応急処置</h2>
      <div class="steps-container">
        {steps.map(s => (
          <div class="step-col">
            <span class="step-num">{s.step}</span>
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
      <p class="caution-note">⚠️ {cautionNotes}</p>
    </section>

    <!-- 3. やってはいけないNG対処法 -->
    <section class="content-block ng-section">
      <h2 class="block-title block-title-warning">やってはいけないこと（二次被害防止）</h2>
      <div class="ng-grid">
        {dontDoList.map(item => (
          <div class="card ng-card">
            <h3><span class="ng-icon">{item.icon}</span> {item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. 専門業者へ相談すべき危険な状況 -->
    <section class="content-block danger-section">
      <h2 class="block-title block-title-danger">専門業者へ直ちにご相談いただきたい状況</h2>
      <div class="danger-grid">
        {whenToCallList.map(item => (
          <div class="card danger-card">
            <h3><span class="danger-icon">{item.icon}</span> {item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. 作業内容と修理料金の目安 -->
    <section class="content-block">
      <div class="block-header-flex">
        <h2 class="block-title">作業内容と修理料金の目安</h2>
        <a href="/pricing/" class="sub-link">料金体系の詳細を見る →</a>
      </div>
      <div class="price-table-box">
        <table class="styled-table">
          <thead>
            <tr>
              <th style="width: 45%;">作業内容</th>
              <th style="width: 25%;">作業時間目安</th>
              <th style="width: 30%;">修理料金目安（税込）</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>基本診断料（現地点検・調査）</strong></td>
              <td>15〜30分</td>
              <td>3,500円（時間外5,000円）</td>
            </tr>
            {priceItems.map(p => (
              <tr>
                <td><strong>{p.name}</strong></td>
                <td>{p.time}</td>
                <td><span class="price-val">{p.price}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        ※必ず作業前に現地調査を行い、確定お見積もりを提示いたします。追加費用ゼロをお約束します。
      </p>
    </section>

    <!-- 6. 実際の施工事例（写真付き・相互リンク） -->
    <section class="content-block">
      <div class="block-header-flex">
        <h2 class="block-title">{title}の実際の施工実績</h2>
        <a href="/works/" class="sub-link">施工事例一覧を見る（全64件） →</a>
      </div>

      <div class="service-cases-grid">
        {displayCases.map(c => (
          <article class="card service-case-card">
            <div class="sc-img-wrap">
              <img
                src={c.beforeImage}
                alt={`${c.municipality} ${c.title}`}
                loading="lazy"
                class="sc-img"
                onerror="this.src='/images/character/kripton-man4-1.jpg'"
              />
              <span class="badge badge-location">{c.municipality}</span>
            </div>
            <div class="sc-body">
              <time class="sc-date">{c.date}</time>
              <h3 class="sc-title">
                <a href={`/works/${c.slug}/`}>{c.title}</a>
              </h3>
              <p class="sc-consult">{c.consultation.slice(0, 75)}...</p>
              <a href={`/works/${c.slug}/`} class="sc-link">詳細・Before/After写真 →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 7. よくあるご質問（FAQ） -->
    {faqs && faqs.length > 0 && (
      <section class="content-block faq-section">
        <h2 class="block-title">{title}に関するよくある質問</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <div class="faq-item">
              <h3 class="faq-q"><span class="q-badge">Q</span> {faq.q}</h3>
              <p class="faq-a"><span class="a-badge">A</span> {faq.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 8. 対応地域リンク（相互内部リンク） -->
    <section class="content-block area-link-block">
      <h2 class="block-title">対応地域・重点エリア</h2>
      <p class="block-sub-text">
        那須塩原市・大田原市・那須町の各市町水道局指定工事店として迅速に急行します。
      </p>
      <div class="area-badges-grid">
        {areasData.map(a => (
          <a href={`/areas/${a.id}/`} class="area-link-card">
            <span class="a-name">{a.name}</span>
            <span class="a-time">{a.responseTime}駆けつけ</span>
            <span class="a-arrow">詳細 →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 緊急電話CTAバナー -->
    <div class="service-cta-banner">
      <div class="banner-text">
        <h3>{title}のお困りごと、今すぐ解決いたします！</h3>
        <p>那須塩原市・大田原市・那須町なら最短30分で駆けつけ。お電話1本で専門スタッフが対応します。</p>
      </div>
      <div class="banner-btn-group">
        <a href={`tel:${companyData.telEmergency}`} class="btn btn-phone btn-cta-large">
          🚨 090-2463-6638（24時間直通）
        </a>
      </div>
    </div>
  </div>

  <!-- Service 構造化データ（JSON-LD） -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": title,
    "description": metaDescription,
    "provider": {
      "@type": "Plumber",
      "name": "有限会社クリプトン（水まわり専門店クリプトン）",
      "url": siteDomain,
      "telephone": "0287-60-5050",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "黒磯2-11",
        "addressLocality": "那須塩原市",
        "addressRegion": "栃木県",
        "postalCode": "325-0017",
        "addressCountry": "JP"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "那須塩原市" },
      { "@type": "City", "name": "大田原市" },
      { "@type": "AdministrativeArea", "name": "那須町" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `${title} 料金メニュー`,
      "itemListElement": priceItems.map(p => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": p.name
        },
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "JPY",
          "price": p.price.replace(/[^\d]/g, '') || "5500"
        }
      }))
    }
  })} />

  <!-- FAQPage 構造化データ（JSON-LD） -->
  {faqs && faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    })} />
  )}
</Layout>

<style>
  .service-page-header {
    background: linear-gradient(135deg, #123B65 0%, #1976BB 100%);
    color: #FFFFFF;
    padding: 35px 0 45px;
  }

  .breadcrumb {
    font-size: 0.8rem;
    margin-bottom: 16px;
    opacity: 0.85;
  }

  .breadcrumb a {
    color: #FFFFFF;
  }

  .header-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .page-title {
    font-size: 2.1rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .page-lead {
    font-size: 1.05rem;
    color: #E2EEF8;
    line-height: 1.6;
  }

  .page-content-container {
    padding: 50px 20px;
    max-width: 980px;
  }

  /* ダイレクトアンサー */
  .direct-answer-card {
    background: #FFFBE6;
    border: 2px solid #FFE58F;
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 40px;
  }

  .da-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .da-icon {
    font-size: 1.5rem;
  }

  .da-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #874D00;
    margin: 0;
  }

  .da-body p {
    font-size: 0.95rem;
    color: #595959;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .da-body p:last-child {
    margin-bottom: 0;
  }

  .content-block {
    margin-bottom: 45px;
  }

  .block-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-main);
    border-left: 5px solid var(--color-sub);
    padding-left: 14px;
    margin-bottom: 20px;
  }

  .block-title-warning {
    border-left-color: #FAAD14;
    color: #D46B08;
  }

  .block-title-danger {
    border-left-color: #FF4D4F;
    color: #CF1322;
  }

  .block-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .sub-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-sub);
  }

  /* 主な症状 */
  .trouble-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .trouble-item {
    padding: 20px;
    background: var(--color-bg-sub);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .trouble-item h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 8px;
  }

  .trouble-item p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* 応急処置ステップ */
  .steps-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .step-col {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 20px;
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .step-num {
    display: inline-block;
    background: var(--color-sub);
    color: #FFFFFF;
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  .step-col h4 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-main);
    margin-bottom: 8px;
  }

  .step-col p {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .caution-note {
    margin-top: 14px;
    font-size: 0.82rem;
    color: #874D00;
    background: #FFFBE6;
    padding: 10px 14px;
    border-radius: 6px;
    border-left: 3px solid #FAAD14;
    line-height: 1.5;
  }

  /* やってはいけないこと (NG) */
  .ng-grid, .danger-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .ng-card {
    background: #FFF7E6;
    border: 1px solid #FFE7BA;
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .ng-card h3 {
    font-size: 0.98rem;
    font-weight: 800;
    color: #D46B08;
    margin-bottom: 8px;
  }

  .ng-card p {
    font-size: 0.85rem;
    color: #873800;
    line-height: 1.55;
    margin: 0;
  }

  /* 危険サイン */
  .danger-card {
    background: #FFF1F0;
    border: 1px solid #FFA39E;
    border-radius: var(--radius-md);
    padding: 18px;
  }

  .danger-card h3 {
    font-size: 0.98rem;
    font-weight: 800;
    color: #CF1322;
    margin-bottom: 8px;
  }

  .danger-card p {
    font-size: 0.85rem;
    color: #820014;
    line-height: 1.55;
    margin: 0;
  }

  /* 料金表 */
  .price-table-box {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .styled-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .styled-table th {
    background: var(--color-bg-sub);
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    color: var(--color-main);
    border-bottom: 1px solid var(--color-border);
  }

  .styled-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .price-val {
    color: #CF1322;
    font-weight: 800;
    font-size: 1.05rem;
  }

  .table-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 8px;
  }

  /* 施工事例カード */
  .service-cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }

  .service-case-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
  }

  .sc-img-wrap {
    position: relative;
    height: 170px;
    overflow: hidden;
  }

  .sc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-location {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(18, 59, 101, 0.85);
    color: #FFFFFF;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .sc-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sc-date {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }

  .sc-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .sc-title a {
    color: var(--color-main);
  }

  .sc-consult {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
    flex: 1;
  }

  .sc-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-sub);
  }

  /* FAQ */
  .faq-list {
    display: flex;
