---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/toilet/index.astro",
  "serviceId": "toilet",
  "title": "トイレつまり・水漏れ修理",
  "subtitle": "那須塩原市・大田原市・那須町の公認指定工事店",
  "lead": "便器からの水あふれ、チョロチョロ止まらない水漏れ、タンクの故障など、那須エリア公認指定工事店が最短30分で駆けつけ確実に修理いたします。",
  "directAnswerTitle": "那須塩原市・大田原市・那須町でトイレがつまった時の対応まとめ",
  "directAnswerSummary": "軽度のペーパー詰まりならラバーカップ作業で約30分・8,000円〜。異物（スマホ・オムツ）混入や床下配管の詰まりは便器脱着またはローポンプにて迅速対応します。",
  "directAnswerAction": "レバーを絶対に連続で引かないでください（汚水があふれます）。まずは止水栓をマイナスドライバー等で時計回りに閉めて給水を止めてください。",
  "metaDescription": "那須塩原市・大田原市・那須町のトイレつまり・水漏れ修理なら指定工事店のクリプトン。最短30分駆けつけ、自社責任施工で修理8,000円〜。Before/After写真公開中。",
  "troubles": [
    {
      "icon": "🚽",
      "title": "便器の水が流れない・あふれそう",
      "desc": "トイレットペーパーの過剰流し、異物（おもちゃ・スマホ）落下が原因です。"
    },
    {
      "icon": "💧",
      "title": "タンクからチョロチョロ水漏れ",
      "desc": "タンク内部のフロートゴム玉やボールタップの経年劣化が原因です。"
    },
    {
      "icon": "🚰",
      "title": "給水管や止水栓からの水漏れ",
      "desc": "接続パッキンの硬化やナットの緩みによるにじみ漏水です。"
    },
    {
      "icon": "⚡",
      "title": "温水洗浄便座からの水漏れ",
      "desc": "内部温水タンクやバルブの劣化。本体交換が必要な場合もあります。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "止水栓を閉める",
      "desc": "便器横の配管にあるマイナス溝を時計回りに回して水を止めます。"
    },
    {
      "step": "STEP 2",
      "title": "コンセントを抜く",
      "desc": "ウォシュレットの漏電を防ぐため電源プラグを抜きます。"
    },
    {
      "step": "STEP 3",
      "title": "水位を下げる",
      "desc": "あふれそうな場合はバケツ等で水を汲み出しておきます。"
    }
  ],
  "priceItems": [
    {
      "name": "トイレつまり除去（軽度・ローポンプ作業）",
      "time": "約30分",
      "price": "8,000円〜"
    },
    {
      "name": "タンク内部品交換（ボールタップ・ゴム玉）",
      "time": "約30〜45分",
      "price": "8,000円〜 + 部品実費"
    },
    {
      "name": "便器脱着作業（異物落下・重度詰まり）",
      "time": "約1.5〜2時間",
      "price": "15,000円〜"
    },
    {
      "name": "最新節水型便器・ウォシュレット交換工事",
      "time": "約3〜4時間",
      "price": "現地事前お見積もり"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
