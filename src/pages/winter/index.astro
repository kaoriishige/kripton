---
// src/pages/winter/index.astro
// 那須地域の冬の水まわり対策完全ガイド（予防・給湯器・解氷・別荘水抜き）
import Layout from '../../layouts/Layout.astro';
import { companyData } from '../../data/company';
import { allCasesData } from '../../data/all_cases';

// 凍結・給湯器・寒波に関連する実際の施工事例を抽出（ファクト遵守）
const winterCaseSlugs = ['boiler-011', 'boiler-009', 'boiler-010'];
const relatedCases = allCasesData.filter(c => winterCaseSlugs.includes(c.slug));

// 構造化データ（FAQPage）
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "水道管が凍結する気温の目安は何℃ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "外気温がマイナス4℃以下になると水道管内部の水が凍結しやすくなります。特に那須町や那須塩原市の北風が当たる場所、屋外露出配管、日当たりの悪い北側の配管はマイナス1〜2℃でも凍結することがあります。"
      }
    },
    {
      "@type": "Question",
      "name": "凍結した水道管に熱湯をかけてもいいですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "熱湯をかけるのは絶対に厳禁です。急激な熱膨張により金属配管や蛇口器具が破損・破裂し、大規模な漏水事故につながります。タオルを巻いて人肌〜50℃程度のぬるま湯をかけるか、ドライヤーの温風でゆっくり解凍してください。"
      }
    },
    {
      "@type": "Question",
      "name": "冬の間、給湯器の電源は切っておいた方がいいですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "給湯器の電源プラグ（コンセント）は絶対に抜かないでください。給湯器には外気温を感知して自動作動する凍結防止ヒーターが内蔵されています。リモコンの運転スイッチをOFFにしても電源プラグは差したままにしてください。"
      }
    },
    {
      "@type": "Question",
      "name": "那須高原の別荘で冬に不在にする時はどうすればいいですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "不凍栓（水抜き栓）による完全な「水抜き（水落とし）」が必要です。不凍栓を閉めた後、家中の蛇口をすべて開けて管内の水を排出し、給湯器の水抜き栓の開放、トイレのトラップへの不凍液注入を行ってください。"
      }
    }
  ]
};

// 構造化データ（Article）
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "那須地域の冬の水まわり対策｜水道管・給湯器の凍結予防と対処法【クリプトン公式】",
  "description": "那須塩原市・大田原市・那須町の水道管・給湯器の凍結予防、万が一の正しい解氷法、破裂時の応急処置、別荘の水抜き手順を水道局指定工事店クリプトンが解説。",
  "image": "https://mizumawari-kripton.com/images/winter/winter-kripton-hero.webp",
  "author": {
    "@type": "Organization",
    "name": "水まわり専門店クリプトン（有限会社クリプトン）",
    "url": "https://mizumawari-kripton.com/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "水まわり専門店クリプトン",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mizumawari-kripton.com/images/character/kripton-man4-1.jpg"
    }
  },
  "datePublished": "2026-11-10",
  "dateModified": "2026-11-10"
};

const breadcrumbItems = [
  { name: "冬の水まわり対策", url: "/winter/" }
];
---

<Layout
  title="那須地域の冬の水まわり対策｜水道管・給湯器の凍結予防と対処法【クリプトン公式】"
  description="那須塩原市・大田原市・那須町の水道管・給湯器の凍結予防、万が一の正しい解氷法、破裂時の応急処置、別荘の水抜き手順を水道局指定工事店クリプトンが解説。創業30年の寒冷地ノウハウ。"
  ogImage="/images/winter/winter-kripton-hero.webp"
  breadcrumbItems={breadcrumbItems}
>
  <!-- 構造化データ埋め込み -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- ヒーローヘッダー -->
  <header class="winter-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a> &gt; <span>冬の水まわり対策</span>
      </nav>
      <div class="header-badge">
        <span class="badge-tag">❄️ 那須地域（那須塩原・大田原・那須町）特化</span>
        <span class="badge-sub">寒冷地の水道局指定工事店が直伝</span>
      </div>
      <h1 class="page-title">
        那須地域の冬の水まわり対策<br />
        <span class="title-sub">水道管・給湯器の凍結予防と万が一の正しい対処法</span>
      </h1>
      <p class="page-lead">
        那須塩原市・大田原市・那須町は、真冬になると氷点下4℃以下まで厳しく冷え込みます。<br class="br-pc" />
        水道管の凍結予防から、万が一凍った時の安全な解氷手順、破裂時の応急処置、別荘の水抜きまで、創業30年の専門店が分かりやすく解説します。
      </p>
    </div>
  </header>

  <!-- クイックアンカーナビ -->
  <div class="toc-bar">
    <div class="container toc-inner">
      <span class="toc-title">目次ジャンプ：</span>
      <div class="toc-links">
        <a href="#cause" class="toc-chip">① 凍結の原因</a>
        <a href="#places" class="toc-chip">② 凍結しやすい場所</a>
        <a href="#prevention" class="toc-chip">③ 自宅でできる予防</a>
        <a href="#boiler" class="toc-chip">④ 給湯器・エコキュート</a>
        <a href="#defrost" class="toc-chip highlight-chip">⑤ 凍った時の対処法</a>
        <a href="#burst" class="toc-chip highlight-chip">⑥ 破裂時の応急処置</a>
        <a href="#villa" class="toc-chip">⑦ 別荘の水抜き</a>
        <a href="#cases" class="toc-chip">⑧ 実際の施工事例</a>
        <a href="#contact" class="toc-chip contact-chip">点検・修理相談</a>
      </div>
    </div>
  </div>

  <main class="winter-main">
    <div class="container">

      <!-- 緊急連絡コールアウト -->
      <div class="emergency-callout">
        <div class="ec-icon">🚨</div>
        <div class="ec-body">
          <h2 class="ec-heading">今まさに「水が出ない」「配管から水が噴き出している」方へ</h2>
          <p class="ec-desc">
            破裂して水が噴き出している場合は、直ちに<strong>屋外の水道メーターボックス内の元栓（止水栓）</strong>を閉めてください。<br />
            専用の電気解氷機による迅速解氷や、破裂配管の緊急復旧工事に直行いたします。
          </p>
          <div class="ec-actions">
            <a href={`tel:${companyData.telEmergency}`} class="btn-emergency-tel">
              <span class="tel-sub">24時間365日緊急直通（担当：津久井）</span>
              <span class="tel-num">📞 {companyData.telEmergency}</span>
            </a>
            <span class="ec-note">※夜間・早朝も直接職人がお電話をお受けします</span>
          </div>
        </div>
      </div>

      <!-- ① 水道管が凍結する原因 -->
      <section id="cause" class="content-section card">
        <div class="section-title-wrap">
          <span class="section-num">01</span>
          <div>
            <span class="section-sub-en">Cause of Freezing</span>
            <h2 class="section-h2">なぜ那須の冬は水道管が凍結するのか？（凍結の目安気温）</h2>
          </div>
        </div>

        <div class="section-body-grid">
          <div class="text-col">
            <p class="lead-text">
              水道管の凍結は、<strong>外気温がマイナス4℃以下</strong>になると急激にリスクが高まります。
            </p>
            <p>
              那須塩原市・大田原市・那須町は内陸性気候のため、12月下旬から2月下旬にかけて夜間から早朝の放射冷却が激しく、平野部でも氷点下5℃〜8℃、那須高原の山間部ではマイナス10℃以下に達することが珍しくありません。
            </p>
            <div class="info-alert-box">
              <h3 class="iab-title">特に凍結警戒が必要な気象・使用条件</h3>
              <ul class="check-list">
                <li><strong>気象庁の天気予報で「最低気温がマイナス4℃以下」と予想された夜</strong></li>
                <li><strong>一日中気温が氷点下のまま上がらない「真冬日」</strong></li>
                <li><strong>旅行や帰省、出張などで数日間水道を使わず家を留守にするとき</strong></li>
                <li><strong>北風（那須おろし）が強く吹き付ける冷え込みの夜</strong></li>
              </ul>
            </div>
          </div>
          <div class="visual-col">
            <div class="highlight-stat-box">
              <span class="stat-badge">凍結警戒ライン</span>
              <span class="stat-temp">-4℃</span>
              <span class="stat-unit">以下で水道管凍結多発</span>
              <p class="stat-desc">
                那須高原エリアでは−10℃以下になる日もあり、屋内配管でも凍結する危険があります。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ② 凍結しやすい場所 -->
      <section id="places" class="content-section card">
        <div class="section-title-wrap">
          <span class="section-num">02</span>
          <div>
            <span class="section-sub-en">Vulnerable Places</span>
            <h2 class="section-h2">要注意！家の中で「凍結しやすい場所」チェックリスト</h2>
          </div>
        </div>

        <p class="lead-text">
          日頃から以下の場所を確認し、保温材の劣化や隙間がないか点検しておきましょう。
        </p>

        <div class="places-grid">
          <div class="place-card">
            <span class="place-icon">🚰</span>
            <h3>屋外の露出配管・立水栓・散水栓</h3>
            <p>外気に直接さらされている庭の立水栓や、給湯器へ接続する立ち上がり配管は最も凍結しやすい場所です。保温材が破れて配管が剥き出しになっていないか確認してください。</p>
          </div>

          <div class="place-card">
            <span class="place-icon">🧭</span>
            <h3>建物の北側・日当たりの悪い場所</h3>
            <p>日光が当たらず、日中でも気温が上がりにくい北側の勝手口、台所、給湯器設置場所は、冷気が滞留して凍結が夕方まで続くことがあります。</p>
          </div>

          <div class="place-card">
            <span class="place-icon">💨</span>
            <h3>北風・すきま風が強く当たる場所</h3>
            <p>風通しのよい床下、車庫内、渡り廊下、勝手口の通気口付近の配管は、強い北風によって急速に熱を奪われ凍結します。</p>
          </div>

          <div class="place-card">
            <span class="place-icon">📦</span>
            <h3>水道メーターボックス内部</h3>
            <p>地面に埋め込まれた青いプラスチックや鉄製のメーターボックスは、フタの隙間から冷気が吹き込み、ボックス内の水道管やバルブが凍結することがあります。</p>
          </div>
        </div>
      </section>

      <!-- ③ 自宅でできる凍結予防 -->
      <section id="prevention" class="content-section card">
        <div class="section-title-wrap">
          <span class="section-num">03</span>
          <div>
            <span class="section-sub-en">Home Prevention</span>
            <h2 class="section-h2">今日から自宅ですぐできる水道管の凍結予防策</h2>
          </div>
        </div>

        <div class="prevention-steps">
          <div class="prev-item">
            <div class="prev-head">
              <span class="prev-badge">対策 1</span>
              <h3>露出している水道管・蛇口に保温材を巻く</h3>
            </div>
            <p>
              ホームセンター等で販売されている水道用保温チューブ（ウレタンフォーム）を配管に巻き、雨水が入らないよう上からビニールテープを隙間なく巻き付けます。<br />
              手元に保温チューブがない場合は、<strong>不要になった毛布や厚手のタオル</strong>を巻き付け、その上からビニール袋を被せてテープでしっかり固定するだけでも大きな予防効果があります。
            </p>
          </div>

          <div class="prev-item">
            <div class="prev-head">
              <span class="prev-badge">対策 2</span>
              <h3>水道メーターボックス内に保温材を入れる</h3>
            </div>
            <p>
              屋外のメーターボックスのフタを開け、ビニール袋に入れた発泡スチロール片や布切れ、古タオルを隙間に詰めて冷気を遮断します。<br />
              <strong>注意：</strong>水道検針の邪魔にならないよう、メーター針の表示部分は見えるようにしてください。また、布が濡れると逆効果になるため、必ずビニール袋に入れて密封してください。
            </p>
          </div>

          <div class="prev-item">
            <div class="prev-head">
              <span class="prev-badge">対策 3</span>
              <h3>冷え込みが厳しい夜は「チョロチョロ水出し」</h3>
            </div>
            <p>
              マイナス4℃以下が予報される真冬の夜は、就寝前に一番冷えやすい蛇口（台所や浴室など）から、<strong>鉛筆の芯ほどの太さ（糸を引く程度）</strong>で水を流し続けておきます。<br />
              水は動いていれば凍りにくいため、極めて効果的です。流した水はバケツや浴槽に溜めておけば、翌日の洗濯や掃除、お風呂の水張りに無駄なく使えます。
            </p>
          </div>
        </div>
      </section>

      <!-- ④ 給湯器・エコキュートの凍結予防 -->
      <section id="boiler" class="content-section card">
        <div class="section-title-wrap">
          <span class="section-num">04</span>
          <div>
            <span class="section-sub-en">Water Heater Protection</span>
            <h2 class="section-h2">給湯器・エコキュート・ボイラーの冬期凍結予防</h2>
          </div>
        </div>

        <p class="lead-text">
          「朝起きたらお湯側の蛇口から水も出ない！」というトラブルは、給湯器配管の凍結が原因です。
        </p>

        <div class="boiler-guides">
          <div class="boiler-point-card">
            <div class="bp-icon">🔌</div>
            <div class="bp-content">
              <h3>給湯器の電源プラグは絶対に抜かない！</h3>
              <p>
                ガス給湯器・石油給湯機・エコキュートには、外気温が下がると自動で作動する「凍結防止ヒーター」が内蔵されています。<br />
                リモコンの運転スイッチをOFFにしても、<strong>屋外のコンセントに差してある電源プラグは絶対に抜かないでください</strong>。プラグを抜いてしまうとヒーターが作動せず、機器内部の熱交換器が凍結破裂して高額な交換修理になってしまいます。
              </p>
            </div>
          </div>

          <div class="boiler-point-card">
            <div class="bp-icon">🛁</div>
            <div class="bp-content">
              <h3>追い焚き配管の循環予防（お風呂の残り湯を残す）</h3>
              <p>
                フルオートタイプの給湯器・エコキュートは、外気温が下がると浴槽の水を自動循環させて配管凍結を防ぐ機能が付いています。<br />
                冬の間は、<strong>浴槽の循環口（丸い金具）の中心より5cm以上上まで残り湯（水）を張った状態</strong>にしておいてください。循環口より水位が低いとポンプが空転し、エラーが出て配管が凍結します。
              </p>
            </div>
          </div>

          <div class="boiler-point-card">
            <div class="bp-icon">🔥</div>
            <div class="bp-content">
              <h3>凍結防止帯（配管ヒーター線）の通電チェック</h3>
              <p>
                寒冷地那須では、給湯器へ接続される配管に電気式の凍結防止帯（ヒーター線）が巻かれています。コンセントが抜けていないか、ブレーカーが落ちていないか冬の初めに必ず確認してください。<br />
                サーモスタットの寿命は一般的に7〜10年程度です。電気代が急に上がった場合や、ヒーターが温まらない場合は断線の可能性があるため点検をご相談ください。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ⑤ 水道管が凍った場合の正しい対処法 -->
      <section id="defrost" class="content-section card highlight-section">
        <div class="section-title-wrap">
          <span class="section-num">05</span>
          <div>
            <span class="section-sub-en">Safe Defrost Method</span>
            <h2 class="section-h2">水道管が凍ってしまった場合の正しい対処法（熱湯厳禁！）</h2>
          </div>
        </div>

        <!-- 警告バナー -->
        <div class="danger-banner">
          <span class="db-icon">🚫</span>
          <div>
            <strong>【絶対厳禁】凍った水道管に熱湯を直接かけてはいけません！</strong>
            <p>熱湯をかけると急激な熱膨張により、銅管や塩ビパイプ、蛇口の内部バルブが破裂します。破裂すると解氷後に大量の水が吹き出し、床下・壁内が水浸しになる二次被害につながります。</p>
          </div>
        </div>

        <div class="defrost-figure-wrap">
          <img 
            src="/images/winter/guide-defrost-safety.webp" 
            alt="水道管が凍った場合の熱湯NGとぬるま湯を使った安全な解氷手順の解説図" 
            width="800" 
            height="500" 
            loading="lazy" 
            class="guide-diagram" 
          />
          <span class="diagram-caption">※解説用図解：安全な解氷手順と熱湯厳禁の理由</span>
        </div>

        <div class="safe-steps-box">
          <h3 class="ss-title">ご自身でできる安全な解凍手順</h3>
          <ol class="step-ol">
            <li>
              <strong>蛇口をわずかに開けておく</strong><br />
              水が出なくても蛇口を少し開けておきます。管内の氷が溶けた時の圧力の逃げ道を作り、水が出始めたらすぐに気づくことができます。
            </li>
            <li>
              <strong>凍結した配管や蛇口にタオルを巻く</strong><br />
              直接お湯をかけるのではなく、タオルを巻くことで熱をまんべんなく行き渡らせ、配管への急激な熱衝撃を防ぎます。
            </li>
            <li>
              <strong>人肌〜50℃程度の「ぬるま湯」をゆっくりかける</strong><br />
              お風呂の湯温程度（ぬるま湯）をタオル越しにゆっくりと少しずつかけます。バケツや洗面器を下に置いて水を受け止めましょう。
            </li>
            <li>
              <strong>または、ドライヤーの温風をまんべんなく当てる</strong><br />
              屋内の蛇口の足元や露出配管には、ヘアドライヤーの温風を一定箇所に集中させず、前後に動かしながら温めます。
            </li>
            <li>
              <strong>水が出始めたら蛇口を閉めて元に戻す</strong><br />
              水が出たらしばらく流して管内に残った氷の粒を排出し、周りに飛び散った水分を乾いたタオルで完全に拭き取ります（拭き取らないと再び凍結します）。
            </li>
          </ol>
        </div>

        <div class="expert-note">
          <span class="en-icon">💡</span>
          <p>
