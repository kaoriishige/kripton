---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/kitchen/index.astro",
  "serviceId": "kitchen",
  "title": "キッチン・台所の水まわり修理",
  "subtitle": "シンク下水漏れ・蛇口交換・排水つまり・システムキッチン",
  "lead": "台所のシングルレバー水栓の水漏れ、シンク下の悪臭・湿気、排水パイプの詰まりなど、毎日の調理に直結するトラブルを即日解消いたします。",
  "directAnswerTitle": "台所の水漏れを発見したときの初動対応",
  "directAnswerSummary": "シンク下からの漏水は排水ジャバラホースの劣化（交換約5,000円〜）や給水管パッキンが原因。放置すると床板が腐食するため早めの修理が重要です。",
  "directAnswerAction": "シンク下の収納扉を開け、収納物を取り出して漏水箇所を確認。シンク下の止水栓を閉めて床の水をタオルで拭き取ってください。",
  "metaDescription": "那須塩原・大田原・那須町のキッチン水漏れ・蛇口交換・排水つまりならクリプトン。シンク下配管修理5,000円〜。水道局指定工事店が自社施工で対応。",
  "troubles": [
    {
      "icon": "🚰",
      "title": "蛇口の根元から水がにじみ出る",
      "desc": "シングルレバーカートリッジの摩耗による内部漏水。"
    },
    {
      "icon": "💧",
      "title": "シンク下の床が濡れている",
      "desc": "排水ジャバラホースの亀裂や防臭パッキンの外れ、排水栓の緩み。"
    },
    {
      "icon": "🍳",
      "title": "排水口の流れが悪い・ゴボゴボ鳴る",
      "desc": "長年の調理油や食材カスが排水管内で冷え固まった詰まり。"
    },
    {
      "icon": "♨️",
      "title": "食洗機や浄水器の給排水トラブル",
      "desc": "分岐水栓の接続不良や給水ホースの劣化破損。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "シンク下の止水栓を閉める",
      "desc": "奥にある湯・水の止水バルブを回して給水を遮断します。"
    },
    {
      "step": "STEP 2",
      "title": "床面の吸水",
      "desc": "床材の変形・カビを防ぐため、タオルで水分を速やかに拭き取ります。"
    },
    {
      "step": "STEP 3",
      "title": "油や固形物を流さない",
      "desc": "パイプ詰まりを悪化させないよう、熱湯や薬品の多用は控えます。"
    }
  ],
  "priceItems": [
    {
      "name": "蛇口カートリッジ・パッキン交換",
      "time": "約30〜45分",
      "price": "5,000円〜 + 部品実費"
    },
    {
      "name": "シンク下排水ジャバラホース交換",
      "time": "約30分",
      "price": "5,000円〜 + 部材実費"
    },
    {
      "name": "キッチンシングルレバー混合栓本体交換",
      "time": "約1時間",
      "price": "8,000円〜 + 本体実費"
    },
    {
      "name": "排水管高圧洗浄・油脂除去作業",
      "time": "約1〜2時間",
      "price": "15,000円〜"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
