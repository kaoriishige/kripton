---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/eco-cute/index.astro",
  "serviceId": "eco-cute",
  "title": "給湯器・ボイラー・エコキュート故障修理",
  "subtitle": "お湯が出ない・エラー表示・寒冷地仕様ボイラー交換",
  "lead": "真冬の朝にお湯が出ない、リモコンにエラーコードが表示される、石油ボイラーから煙や異音がするなど、那須地域の過酷な冬に対応する確かな技術で急行します。",
  "directAnswerTitle": "給湯器が故障してお湯が出ないときの原因と判断基準",
  "directAnswerSummary": "使用年数8年未満なら部品交換（点火プラグ・電磁弁等）での修理が可能。10〜15年以上経過している場合は省エネ性能の高い最新給湯器・エコキュートへの交換をおすすめします。",
  "directAnswerAction": "リモコンに表示されている数字（エラーコード例: 111, 710など）をメモし、電源プラグの抜き差しで改善しない場合は給水元栓を閉めてお電話ください。",
  "metaDescription": "那須塩原・大田原・那須町の給湯器修理・ボイラー交換・エコキュート工事なら指定工事店のクリプトン。寒冷地仕様対応、最短即日駆けつけでお湯のトラブルを解決。",
  "troubles": [
    {
      "icon": "♨️",
      "title": "お湯が出ない・ぬるい・水しか出ない",
      "desc": "点火不良、循環ポンプ故障、温度センサーの故障。"
    },
    {
      "icon": "⚠️",
      "title": "リモコンにエラーコードが点滅する",
      "desc": "燃焼異常（111/121など）や過熱防止装置作動、基板トラブル。"
    },
    {
      "icon": "💧",
      "title": "給湯器本体・配管からの水漏れ",
      "desc": "熱交換器のピンホール穴、安全弁（減圧弁）の不具合、凍結破裂。"
    },
    {
      "icon": "💨",
      "title": "点火時に異音がする・黒い煙が出る",
      "desc": "不完全燃焼、バーナーの詰まり、燃料供給パイプの異常。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "エラー番号の確認",
      "desc": "リモコン画面に表示されている数字3桁を控えます。"
    },
    {
      "step": "STEP 2",
      "title": "燃料・電源の確認",
      "desc": "灯油タンクの残量、ガスの元栓、屋外電源コンセントを確認します。"
    },
    {
      "step": "STEP 3",
      "title": "無理な再点火は避ける",
      "desc": "爆発点火の恐れがあるため、異臭や煙がある場合は使用を中止します。"
    }
  ],
  "priceItems": [
    {
      "name": "給湯器・ボイラー点検診断料",
      "time": "30分",
      "price": "3,500円（時間外5,000円）"
    },
    {
      "name": "配管接続部・安全弁水漏れ修理",
      "time": "約45分",
      "price": "8,000円〜 + 部品代"
    },
    {
      "name": "電磁弁・循環金具等部品交換修理",
      "time": "約1〜2時間",
      "price": "12,000円〜 + 部品実費"
    },
    {
      "name": "寒冷地仕様石油給湯器・エコキュート交換工事",
      "time": "約3〜5時間",
      "price": "現地事前お見積もり"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
