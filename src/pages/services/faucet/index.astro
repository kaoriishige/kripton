---
import ServiceDetailTemplate from '../../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/services/faucet/index.astro",
  "serviceId": "faucet",
  "title": "蛇口修理・水栓交換",
  "subtitle": "ポタポタ水漏れ・レバー操作不良・最新水栓交換",
  "lead": "しっかり閉めても蛇口からポタポタ水が止まらない、ハンドルレバーが固くて動かない、シャワーノズルから水漏れするなど、台所・浴室・洗面所の水栓を即日修繕します。",
  "directAnswerTitle": "蛇口のポタポタ水漏れは自分で直せる？",
  "directAnswerSummary": "単水栓のコマパッキン交換ならDIYも可能ですが、最新のシングルレバー混合栓は内部カートリッジの破損や固着が多く、無理に分解すると配管破損につながるためプロへの依頼が安心です。",
  "directAnswerAction": "水栓下にある左右の止水栓、または屋外の水道元栓を閉めて給水を止め、水栓のメーカー・型番（TOTO, LIXIL, KVK等）をご確認ください。",
  "metaDescription": "那須塩原・大田原・那須町の蛇口水漏れ修理・混合栓交換ならクリプトン。パッキン交換8,000円〜、TOTO・LIXIL・KVK対応、即日自社責任施工。",
  "troubles": [
    {
      "icon": "💧",
      "title": "吐水口からのポタポタ漏水",
      "desc": "パッキンの摩耗、シングルレバーカートリッジの弁摩耗。"
    },
    {
      "icon": "🚰",
      "title": "レバーハンドル下からの水漏れ",
      "desc": "内部Oリングの劣化、カートリッジ固定ナットの緩み。"
    },
    {
      "icon": "🦴",
      "title": "レバーが異様に固い・キーキー異音がする",
      "desc": "内部可動部のグリス切れ、カルキ付着、金属疲労。"
    },
    {
      "icon": "✨",
      "title": "使いやすい最新水栓へ交換したい",
      "desc": "節水エコハンドル水栓、タッチレス自動水栓、浄水器内蔵水栓。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "水栓の止水",
      "desc": "水栓下のマイナスネジを右に回して水を止めます。"
    },
    {
      "step": "STEP 2",
      "title": "水栓メーカー・品番の確認",
      "desc": "蛇口の根元や側面に貼ってあるラベルの品番をチェックします。"
    },
    {
      "step": "STEP 3",
      "title": "クリプトンへ連絡",
      "desc": "純正部品または最新適合水栓を車載して迅速に駆けつけます。"
    }
  ],
  "priceItems": [
    {
      "name": "蛇口パッキン・コマ・Oリング交換",
      "time": "約30分",
      "price": "8,000円〜"
    },
    {
      "name": "シングルレバーカートリッジ交換",
      "time": "約30〜45分",
      "price": "8,000円〜 + 部品実費"
    },
    {
      "name": "台所・浴室・洗面混合水栓本体交換工賃",
      "time": "約1時間",
      "price": "8,000円〜 + 本体実費"
    },
    {
      "name": "最新タッチレスセンサー水栓取付工事",
      "time": "約1〜1.5時間",
      "price": "10,000円〜 + 本体実費"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
