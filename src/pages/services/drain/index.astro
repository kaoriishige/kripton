      "price": "5,000円〜"
    },
    {
      "name": "ローポンプ圧送による詰まり貫通作業",
      "time": "約30〜45分",
      "price": "8,000円〜"
    },
    {
      "name": "電動トーラーワイヤーによる管内清掃",
      "time": "約1時間",
      "price": "12,000円〜"
    },
    {
      "name": "屋外排水管・マスのプロ用高圧洗浄作業",
      "time": "約1〜2時間",
      "price": "18,000円〜"
