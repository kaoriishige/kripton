  "troubles": [
    {
      "icon": "🧼",
      "title": "台所シンクの水が溜まって流れない",
      "desc": "長年の調理油、洗剤カス、微細な食材ゴミの管内蓄積固着。"
    },
    {
      "icon": "🚽",
      "title": "トイレを流すと他の排水口がゴボゴボ鳴る",
      "desc": "本管合流部や屋外排水マス付近の詰まりによる空気抜け不良。"
    },
    {
      "icon": "🕳️",
      "title": "屋外の排水マスから汚水があふれている",
      "desc": "木の根の侵入、地中配管の割れや勾配不良、ペーパー堆積。"
    },
    {
      "icon": "👃",
      "title": "排水口から耐えられない悪臭が上がる",
      "desc": "防臭パッキンの破損、トラップ封水切れ、管内スラッジの腐敗。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "排水の使用を中止",
      "desc": "水を追加で流さず、排水口周りのゴミ受けを清掃します。"
    },
    {
      "step": "STEP 2",
      "title": "屋外排水マスの確認",
      "desc": "庭や駐車場の排水フタを開け、汚水が溜まっていないか確認します。"
    },
    {
      "step": "STEP 3",
      "title": "専門機材による洗浄",
      "desc": "クリプトンの高圧洗浄機・管内ワイヤーで詰まりを粉砕・排出します。"
