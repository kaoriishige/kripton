---
import ServiceDetailTemplate from '../../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/services/water-leak/index.astro",
  "serviceId": "water-leak",
  "title": "水漏れ修理・漏水調査",
  "subtitle": "那須塩原市・大田原市・那須町の水道局公認指定工事店",
  "lead": "水道局の検針で漏水を指摘された、壁や床から水の音がする、元栓を閉めても水道メーターが回り続けるなど、目に見えない配管漏水も専門技術で迅速に特定・修繕します。",
  "directAnswerTitle": "水道局から「漏水の疑い」を指摘されたらどうする？",
  "directAnswerSummary": "水道局公認の「指定工事店」であるクリプトンが漏水箇所の探査・修繕を行い、水道料金の減免申請に必要な「漏水修繕証明書」を正式発行いたします。",
  "directAnswerAction": "宅内のすべての蛇口を閉めた状態で、水道メーターボックス内のパイロット（銀色の星型金具）が回転しているか確認してください。回転していれば漏水しています。",
  "metaDescription": "那須塩原市・大田原市・那須町の水漏れ修理・漏水調査なら指定工事店のクリプトン。水道料金減免申請対応、床下・壁内配管修繕、最短30分駆けつけ。",
  "troubles": [
    {
      "icon": "🔍",
      "title": "水道料金が急に高くなった・検針で指摘",
      "desc": "地中埋設管、床下、壁内など見えない箇所での経年劣化漏水。"
    },
    {
      "icon": "💧",
      "title": "天井・壁・床から水が染み出てくる",
      "desc": "給水管・給湯管の継手ピンホール、排水管の勾配不良やヒビ割れ。"
    },
    {
      "icon": "🚰",
      "title": "屋外の地面が常に濡れている・水たまり",
      "desc": "散水栓柱や屋外埋設給水パイプの経年破損やジョイント外れ。"
    },
    {
      "icon": "⚠️",
      "title": "配管からシューという水音が鳴り止まない",
      "desc": "常時水圧がかかっている給水管からの高圧噴出漏水。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "メーターの元栓を閉める",
      "desc": "屋外の青いフタの量水器内にあるバルブを時計回りに回します。"
    },
    {
      "step": "STEP 2",
      "title": "パイロットの回転確認",
      "desc": "全蛇口閉止時の回転有無で宅内配管漏水の確定診断ができます。"
    },
    {
      "step": "STEP 3",
      "title": "指定工事店へ修理を依頼",
      "desc": "自治体の水道料金減免制度を受けるには指定工事店の修繕証明が必須です。"
    }
  ],
  "priceItems": [
    {
      "name": "基本漏水調査・点検診断料",
      "time": "30分",
      "price": "5,000円（時間外8,000円）"
    },
    {
      "name": "露出配管一部バイパス・補修工事",
      "time": "約1〜2時間",
      "price": "12,000円〜 + 部材実費"
    },
    {
      "name": "地中埋設給水管掘削・漏水修繕",
      "time": "約2〜4時間",
      "price": "現地事前お見積もり"
    },
    {
      "name": "水道料金減免申請書類作成・提出代行",
      "time": "施工後",
      "price": "工事付随サービス"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
