---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/pump/index.astro",
  "serviceId": "pump",
  "title": "井戸ポンプの修理・交換",
  "subtitle": "浅井戸・深井戸ポンプ・水が出ない・モーター停止不良",
  "lead": "那須地域の一般住宅・別荘・農家様で多く利用されている井戸ポンプ。モーターが回りっぱなし、蛇口の水圧が弱い、砂を噛んで動かないなどのトラブルに急行します。",
  "directAnswerTitle": "井戸ポンプが動かない・水が出ないときの確認点",
  "directAnswerSummary": "圧力スイッチやコンデンサーの故障、呼び水抜けが主な原因です。10年以上稼働したポンプはインバーター制御の省エネ新型ポンプへの交換（最短半日施工）が安心です。",
  "directAnswerAction": "ポンプ本体の電源コンセントを一度抜き、呼び水キャップを開けて水が満たされているか確認してください。空運転を続けるとモーターが焼き付きます。",
  "metaDescription": "那須塩原市・大田原市・那須町の井戸ポンプ修理・浅井戸深井戸ポンプ交換ならクリプトン。モーター異音、圧力低下、水が出ないトラブルに有資格者が迅速対応。",
  "troubles": [
    {
      "icon": "⚙️",
      "title": "ポンプのモーターが止まらない",
      "desc": "圧力スイッチの接点不良、または地中配管からの漏水による圧力低下。"
    },
    {
      "icon": "🚫",
      "title": "蛇口をひねっても水が全く出ない",
      "desc": "呼び水抜け、吸い込み管のエア吸い、モーター焼損。"
    },
    {
      "icon": "🔊",
      "title": "ポンプからガラガラと異音がする",
      "desc": "ベアリングの摩耗、インペラーへの砂噛み、凍結によるファン破損。"
    },
    {
      "icon": "💧",
      "title": "ポンプ本体周囲からの水漏れ",
      "desc": "メカニカルシールの劣化、ケーシングのサビ割れ、凍結破損。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "電源を遮断する",
      "desc": "モーター焼き付きを防ぐため、コンセントプラグを抜きます。"
    },
    {
      "step": "STEP 2",
      "title": "水漏れの有無を確認",
      "desc": "宅内蛇口がすべて閉まっているのに回る場合は漏水調査が必要です。"
    },
    {
      "step": "STEP 3",
      "title": "クリプトンへ診断依頼",
      "desc": "浅井戸・深井戸、ポンプ型番を確認し迅速に部品を手配します。"
    }
  ],
  "priceItems": [
    {
      "name": "井戸ポンプの修理",
      "time": "約45分〜",
      "price": "8,000円〜"
    },
    {
      "name": "呼び水充填・エア抜き・圧力調整",
      "time": "約45分",
      "price": "8,000円〜"
    },
    {
      "name": "圧力スイッチ・コンデンサー部品交換",
      "time": "約1時間",
      "price": "12,000円〜 + 部品実費"
    },
    {
      "name": "浅井戸・深井戸新型インバーターポンプ交換",
      "time": "約2〜4時間",
      "price": "現地事前お見積もり"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
