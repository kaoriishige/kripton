---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/washroom/index.astro",
  "serviceId": "washroom",
  "title": "洗面所・洗濯機まわりの修理",
  "subtitle": "シャワーホース水漏れ・排水トラップ詰まり・洗面化粧台交換",
  "lead": "洗面台下の水漏れ、シャワーホースからの水垂れ、洗濯機給水栓のトラブルなど、脱衣所・洗面所の水まわり不具合を迅速に修繕いたします。",
  "directAnswerTitle": "洗面台の下が濡れている原因と対処法",
  "directAnswerSummary": "最も多い原因は「シャワー水栓ホースの亀裂」です（引き出し式ホースの金属被覆内から水漏れ）。ホース交換または水栓一式交換（8,000円〜）で解決します。",
  "directAnswerAction": "シャワーホースの水を洗面器などで受け、洗面台下の止水栓を閉めて専門技術者へご連絡ください。",
  "metaDescription": "那須塩原市・大田原市・那須町の洗面所修理・洗面化粧台交換ならクリプトン。シャワーホース水漏れ、Sトラップ詰まり、洗濯機水栓修理に迅速出動。",
  "troubles": [
    {
      "icon": "🪞",
      "title": "洗面台下収納への水漏れ",
      "desc": "引き出しシャワーホースの破れ、S字トラップ接続部の緩み。"
    },
    {
      "icon": "💧",
      "title": "洗面ボウルの水が流れない",
      "desc": "ヘアキャッチャーのゴミ詰まり、Sトラップへの異物（ヘアピン等）混入。"
    },
    {
      "icon": "🧺",
      "title": "洗濯機用給水栓・ワンタッチ継手漏水",
      "desc": "緊急止水弁の動作不良、ホース接続用パッキンの劣化。"
    },
    {
      "icon": "💡",
      "title": "洗面化粧台の老朽化・ヒビ割れ",
      "desc": "陶器ボウルの割れ、キャビネットの腐食に伴う洗面台全面交換。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "洗面下の止水栓を閉める",
      "desc": "止水栓を閉め、ホース受け水受けトレイの水を捨てます。"
    },
    {
      "step": "STEP 2",
      "title": "排水口のゴミ除去",
      "desc": "ポップアップ弁を真上に引き抜いて絡まった髪の毛を除去します。"
    },
    {
      "step": "STEP 3",
      "title": "クリプトンへ連絡",
      "desc": "ホースやトラップの部材適合を現場で確認し即日修繕します。"
    }
  ],
  "priceItems": [
    {
      "name": "洗面所S字トラップつまり除去",
      "time": "約30分",
      "price": "5,000円〜"
    },
    {
      "name": "洗面台シャワーホース・水栓修理",
      "time": "約45分",
      "price": "6,000円〜 + 部材実費"
    },
    {
      "name": "洗濯機専用水栓（緊急止水弁付）交換",
      "time": "約30〜45分",
      "price": "8,000円〜 + 本体実費"
    },
    {
      "name": "最新洗面化粧台への本体交換工事",
      "time": "約2〜3時間",
      "price": "現地事前お見積もり"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
