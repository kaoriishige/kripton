---
import ServiceDetailTemplate from '../../components/ServiceDetailTemplate.astro';

const props = {
  "filePath": "src/pages/bath/index.astro",
  "serviceId": "bath",
  "title": "浴室・お風呂の水まわり修理",
  "subtitle": "シャワー水漏れ・蛇口故障・排水つまり・ユニットバスリフォーム",
  "lead": "シャワーの水圧が弱い、温度調整が効かない、洗い場の排水が流れないなど、お風呂のあらゆるトラブルに自社施工で迅速対応いたします。",
  "directAnswerTitle": "お風呂の水漏れ・シャワー故障時のチェックポイント",
  "directAnswerSummary": "シャワーヘッドやホースからの水漏れはパッキン交換（8,000円〜）で即日解決可能。サーモスタット水栓本体の経年劣化時は最新水栓への交換をご提案します。",
  "directAnswerAction": "シャワーやカランから水が止まらない場合は、水栓クランク部にあるマイナス止水栓、または屋外の水道メーター元栓を閉めてください。",
  "metaDescription": "那須塩原市・大田原市・那須町のお風呂・浴室修理ならクリプトン。シャワー水漏れ、サーモスタット水栓交換、排水詰まりに迅速出動。自社施工で安心対応。",
  "troubles": [
    {
      "icon": "🚿",
      "title": "シャワー・カランからの水漏れ",
      "desc": "切替弁カートリッジの摩耗やパッキンの劣化によるポタポタ漏水。"
    },
    {
      "icon": "🌡️",
      "title": "お湯の温度が安定しない・ぬるい",
      "desc": "サーモスタット温調部の故障、または給湯器ボイラー側の不具合。"
    },
    {
      "icon": "🧼",
      "title": "洗い場の排水が逆流する・流れない",
      "desc": "排水トラップ内の髪の毛・石鹸カス詰まり、排水管内の蓄積汚れ。"
    },
    {
      "icon": "🛁",
      "title": "浴槽循環口の不具合・追い焚き不良",
      "desc": "循環口フィルターの詰まりや追い焚き配管の循環不良。"
    }
  ],
  "steps": [
    {
      "step": "STEP 1",
      "title": "水栓の止水確認",
      "desc": "蛇口の根元にある左右の止水栓ネジを回して給水を止めます。"
    },
    {
      "step": "STEP 2",
      "title": "排水目皿の清掃",
      "desc": "洗い場の排水カバーを外し、ヘアキャッチャーのゴミを取り除きます。"
    },
    {
      "step": "STEP 3",
      "title": "専門業者へ連絡",
      "desc": "配管奥の詰まりや内部金具の破損時は無理にいじらずご連絡ください。"
    }
  ],
  "priceItems": [
    {
      "name": "シャワー・蛇口パッキン交換",
      "time": "約30分",
      "price": "8,000円〜"
    },
    {
      "name": "サーモスタット混合水栓本体交換",
      "time": "約1時間",
      "price": "8,000円〜 + 本体実費"
    },
    {
      "name": "浴室排水つまり除去・薬品洗浄",
      "time": "約30〜45分",
      "price": "8,000円〜"
    },
    {
      "name": "ユニットバス全体リフォーム工事",
      "time": "3〜4日",
      "price": "現地事前お見積もり"
    }
  ]
};
---

<ServiceDetailTemplate {...props} />
