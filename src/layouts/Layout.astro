---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFixedBar from '../components/MobileFixedBar.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "那須塩原市・大田原市・那須町の水漏れ・トイレつまり・給湯器修理なら水まわり専門店クリプトン。指定工事店・自社施工・創業30年の実績で24時間365日緊急対応。",
  ogImage = "/images/character/kripton-man4-1.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://xn--bbkyao7065bpyck41as89d.com');
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- OGP -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- 構造化データ (LocalBusiness / Plumber) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Plumber",
    "name": "有限会社クリプトン（水まわり専門店クリプトン）",
    "image": "https://xn--bbkyao7065bpyck41as89d.com/images/character/kripton-man4-1.jpg",
    "@id": "https://xn--bbkyao7065bpyck41as89d.com",
    "url": "https://xn--bbkyao7065bpyck41as89d.com",
    "telephone": "0287-60-5050",
    "priceRange": "5,000円〜",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "黒磯2-11",
      "addressLocality": "那須塩原市",
      "addressRegion": "栃木県",
      "postalCode": "325-0017",
      "addressCountry": "JP"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 36.9691,
      "longitude": 140.0528
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "08:00",
        "closes": "19:00"
      }
    ],
    "areaServed": [
      { "@type": "City", "name": "那須塩原市" },
      { "@type": "City", "name": "大田原市" },
      { "@type": "AdministrativeArea", "name": "那須町" }
    ]
  })} />
</head>
<body>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <MobileFixedBar />
</body>
</html>
