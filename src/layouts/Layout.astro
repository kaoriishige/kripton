      ]
    }
  })} />

  {/* パンくずリスト構造化データ */}
  {breadcrumbLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  )}
</head>
<body>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <MobileFixedBar />
</body>
</html>
