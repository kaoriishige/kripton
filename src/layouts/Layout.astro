        "telephone": "090-2463-6638",
        "contactType": "emergency",
        "areaServed": ["那須塩原市", "大田原市", "那須郡那須町", "矢板市", "塩谷郡塩谷町"],
        "availableLanguage": "Japanese"
      },
      {
        "@type": "ContactPoint",
        "telephone": "0287-60-5050",
        "contactType": "customer service",
        "areaServed": ["那須塩原市", "大田原市", "那須郡那須町", "矢板市", "塩谷郡塩谷町"],
        "availableLanguage": "Japanese"
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "黒磯2-11",
