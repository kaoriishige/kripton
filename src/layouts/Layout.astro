          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": "5500",
            "minPrice": "5500",
            "priceCurrency": "JPY"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "排水管つまり・高圧洗浄",
            "description": "台所・風呂・屋外排水マスの油汚れ・木の根除去、高圧洗浄"
          },
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": "8800",
            "minPrice": "8800",
            "priceCurrency": "JPY"
          }
        },
        {
          "@type": "Offer",
