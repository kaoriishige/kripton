---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileFixedBar from '../components/MobileFixedBar.astro';

interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  breadcrumbItems?: BreadcrumbItem[];
}

const {
  title,
  description = "那須塩原市・大田原市・那須町の水漏れ・トイレつまり・給湯器修理なら水まわり専門店クリプトン。水道局指定工事店・完全自社施工・1993年創業（実績30年以上）で24時間365日緊急対応。",
  ogImage = "/images/company/kripton.png",
  breadcrumbItems
} = Astro.props;

const siteDomain = 'https://xn--bbkyao7065bpyck41as89d.com';
const canonicalURL = new URL(Astro.url.pathname, siteDomain).toString();

// og:image を必ず完全絶対URLに正規化
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteDomain}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;

// パンくずリスト構造化データ生成
const breadcrumbLd = breadcrumbItems && breadcrumbItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ホーム",
      "item": siteDomain
    },
    ...breadcrumbItems.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 2,
      "name": item.name,
      ...(item.url ? { "item": item.url.startsWith('http') ? item.url : `${siteDomain}${item.url}` } : {})
    }))
  ]
} : null;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- OGP (絶対URL・属性完備) -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="水まわり専門店クリプトン【公式】" />
  <meta property="og:locale" content="ja_JP" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- 構造化データ (LocalBusiness / Plumber: レビュー・Offer・sameAs・E-E-A-T完備) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["Plumber", "LocalBusiness"],
    "@id": `${siteDomain}/#business`,
    "name": "水まわり専門店クリプトン（有限会社クリプトン）",
    "alternateName": ["水まわり専門店クリプトン", "有限会社クリプトン", "クリプトン"],
    "description": "那須塩原市・大田原市・那須町の水漏れ、トイレつまり、給湯器修理、水道管凍結に迅速駆けつけ。創業30年の水道局指定工事店。",
    "image": "https://kripton-ai.netlify.app/images/character/kripton-man4-1.jpg",
    "logo": "https://kripton-ai.netlify.app/images/character/kripton-man4-1.jpg",
    "url": siteDomain,
    "telephone": "090-2463-6638",
